#!/bin/sh
# Starts Kiri's engine in a WSL distro without systemd.
# Windows connects to its Unix socket through kiri bridge.
set -eu
export HOME=/var/lib/kiri-daemon
# This entry point is separate from the systemd service, even if the
# caller is itself running under systemd.
unset INVOCATION_ID STATE_DIRECTORY
socket="$HOME/.kiri/run/docker.sock"
log=/var/log/kiri.log
pattern='^(/usr/local/bin/kiri daemon|/usr/libexec/kiri/kiri-go-daemon)( |$)'
mkdir -p "$HOME" /var/log

running() { pgrep -f "$pattern" >/dev/null 2>&1; }

case "${1:-start}" in
  start) ;;
  restart)
    if running; then
      pkill -TERM -f "$pattern" || true
      # The Go daemon allows up to 25 seconds for container shutdown.
      i=0
      while running && [ "$i" -lt 350 ]; do
        sleep 0.1
        i=$((i + 1))
      done
      if running; then
        echo "Kiri did not stop; see $log" >&2
        exit 1
      fi
    fi
    ;;
  *) echo "usage: kiri-start [start|restart]" >&2; exit 2 ;;
esac

if ! running; then
  rm -f "$socket"
  nohup /usr/local/bin/kiri daemon </dev/null >>"$log" 2>&1 &
fi
i=0
while [ "$i" -lt 50 ]; do
  [ -S "$socket" ] && exit 0
  sleep 0.1
  i=$((i + 1))
done
echo "Kiri did not create its socket; see $log" >&2
exit 1

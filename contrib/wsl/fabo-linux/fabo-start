#!/bin/sh
# Starts Fabo's engine in a WSL distro without systemd.
# Windows connects to its Unix socket through fabo bridge.
set -eu
export HOME=/var/lib/fabo-daemon
# This entry point is separate from the systemd service, even if the
# caller is itself running under systemd.
unset INVOCATION_ID STATE_DIRECTORY
socket="$HOME/.fabo/run/docker.sock"
log=/var/log/fabo.log
pattern='^(/usr/local/bin/fabo daemon|/usr/libexec/fabo/fabo-daemon)( |$)'
mkdir -p "$HOME" /var/log

running() { pgrep -f "$pattern" >/dev/null 2>&1; }

# stop_engine asks the daemon to stop and waits for it; the Go daemon
# allows up to 25 seconds for container shutdown.
stop_engine() {
  running || return 0
  pkill -TERM -f "$pattern" || true
  i=0
  while running && [ "$i" -lt 350 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  if running; then
    echo "Fabo did not stop; see $log" >&2
    exit 1
  fi
}

case "${1:-start}" in
  start) ;;
  stop) stop_engine; exit 0 ;;
  restart) stop_engine ;;
  *) echo "usage: fabo-start [start|stop|restart]" >&2; exit 2 ;;
esac

if ! running; then
  rm -f "$socket"
  nohup /usr/local/bin/fabo daemon </dev/null >>"$log" 2>&1 &
fi
i=0
while [ "$i" -lt 50 ]; do
  [ -S "$socket" ] && exit 0
  sleep 0.1
  i=$((i + 1))
done
echo "Fabo did not create its socket; see $log" >&2
exit 1

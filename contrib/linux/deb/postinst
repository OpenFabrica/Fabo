#!/bin/sh
# Fabo's engine as a system service; whoever ran apt joins the fabo group
# and gets the fabo docker context.
set -e
if [ "$1" = configure ]; then
    getent group fabo >/dev/null || addgroup --system fabo
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != root ] && id "$SUDO_USER" >/dev/null 2>&1; then
        adduser "$SUDO_USER" fabo >/dev/null || true
        # The CLI's context, made as that person so it lands in their ~/.docker.
        su - "$SUDO_USER" -c 'docker context inspect fabo >/dev/null 2>&1 || docker context create fabo --docker host=unix:///run/fabo/docker.sock >/dev/null' || true
        su - "$SUDO_USER" -c 'docker context use fabo >/dev/null' || true
        echo "Fabo: $SUDO_USER is in the fabo group. Log out and back in once for it to apply."
    else
        echo "Fabo: add yourself to the fabo group (sudo adduser \$USER fabo), then log out and back in."
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable fabo.service >/dev/null 2>&1 || true
        systemctl restart fabo.service || true
    fi
fi
exit 0

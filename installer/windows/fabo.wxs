<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fabo for Windows: a per-user MSI around the bundle scripts/windows-bundle.sh
  builds (target/windows/fabo-windows-x86_64). It lays the bundle in
  %LOCALAPPDATA%\Fabo, the folder fabo-win.exe uses anyway, adds a Start menu entry and an
  Apps & features row, and opens Fabo at the end: Fabo's own first-run setup
  then installs WSL if needed, imports the engine, and puts the docker CLI on
  PATH, per user, with no administrator rights. Removing it runs
  fabo.ps1 -Uninstall -IfSetUp (engine out of WSL, PATH and docker context
  undone) and deletes the folder.

  Build on Windows with scripts/windows-msi.ps1 (docs/windows.md), which runs:
    wix build -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=<version> -d Bundle=..\..\target\windows\fabo-windows-x86_64 -d Size="215.0 MB"
      -loc fabo.wxl -o ..\..\target\windows\Fabo-<version>-x86_64.msi fabo.wxs
  scripts/check-wxs.py checks this file against a bundle on any OS.

  Windows on Arm is the same source with -arch arm64,
  -d Bundle=..\..\target\windows\fabo-windows-arm64 and -o
  ..\..\target\windows\Fabo-<version>-arm64.msi: the Platform is Arm64, the custom action
  DLL Wix4UtilCA_A64 ($(sys.BUILDARCHSHORT)), and nothing else differs. A
  per-user install has no Program Files folder to choose, so there is no
  ProgramFiles64Folder/ProgramFilesArm64 question either.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- The version comes from the git tag; scripts/windows-msi.ps1 passes it. -->
  <?ifndef Version ?><?error Pass -d Version=x.y.z (scripts/windows-msi.ps1 does) ?><?endif?>
  <?ifndef Bundle ?><?define Bundle = "..\..\target\windows\fabo-windows-x86_64" ?><?endif?>
  <!-- What the install takes on disk, as the ready page says it: windows-msi.ps1 measures the bundle. -->
  <?ifndef Size ?><?define Size = "" ?><?endif?>
  <?define Name = "Fabo" ?>
  <?define Manufacturer = "Fabo" ?>
  <?define Url = "https://github.com/OpenFabrica/Fabo" ?>
  <?define Description = "Tiny, fast container runtime" ?>
  <?define Keywords = "containers, docker, wsl, runtime" ?>

  <!--
    The UpgradeCode never changes; it is what makes a newer MSI replace an older one.
    It is Fabo's own, not upstream Kiri's: with Kiri's, a Fabo MSI would take
    an installed Kiri for an older Fabo and remove it. fabo-win's updater
    checks it (upgradeCode in engine/cmd/fabo-win/update.go).
    The x64 and arm64 MSIs share it, on purpose: both install the same files
    into the same %LOCALAPPDATA%\Fabo with the same HKCU keys and component
    GUIDs, so two products side by side would fight over one folder. Shared,
    the arm64 MSI replaces an x64 Fabo put on an Arm PC by mistake (as a
    major upgrade, AllowSameVersionUpgrades even at the same version), and
    the reverse. fabo-win's updater checks the MSI's platform as well as
    this code, and reads its own feed per architecture, so an update never
    swaps architectures.
  -->
  <Package Name="$(Name)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="839A68B8-98E7-4BBD-B1DE-DAB0B047B7D4"
           Scope="perUser"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Keywords="$(Keywords)"
                        Description="$(Description)"
                        Comments="$(Description). Docker API on Windows with the engine in WSL2."
                        Manufacturer="$(Manufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of $(Name) is already installed."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FaboIcon" SourceFile="..\..\brand\icon\windows\fabo.ico" />
    <Property Id="ARPPRODUCTICON" Value="FaboIcon" />
    <Property Id="ARPURLINFOABOUT" Value="$(Url)" />
    <Property Id="ARPURLUPDATEINFO" Value="$(Url)" />
    <Property Id="ARPHELPLINK" Value="$(Url)" />
    <Property Id="ARPCONTACT" Value="$(Manufacturer)" />
    <Property Id="ARPCOMMENTS" Value="$(Description)" />
    <!--
      The folder tree util:RemoveFolderEx deletes on uninstall: Fabo's own
      %LOCALAPPDATA%\Fabo, with what the app wrote there (setup.json, logs,
      downloads, a staged update, and wsl\fabo\ext4.vhdx, the Fabo Linux distro's
      disk, which fabo.ps1 unregisters first). The registry value goes into
      FABODIR_FOUND and is copied to FABODIR only when this product is
      already installed and not being replaced: in a major upgrade
      (UPGRADINGPRODUCTCODE is set while the old product is removed) FABODIR
      stays empty, RemoveFolderEx does nothing, and the user's data
      survives. A value that is not <LocalAppData>\Fabo\ (a
      tampered registry, or FABODIR given on the command line) is blanked.
    -->
    <Property Id="FABODIR_FOUND">
      <RegistrySearch Root="HKCU" Key="Software\$(Manufacturer)" Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="FABODIR" Secure="yes" />
    <SetProperty Id="FABODIR_HOME" Value="[LocalAppDataFolder]$(Name)\" After="AppSearch" Sequence="execute" />
    <SetProperty Id="FABODIR" Value="[FABODIR_FOUND]" After="SetFABODIR_HOME" Sequence="execute" Condition="Installed AND NOT UPGRADINGPRODUCTCODE" />
    <SetProperty Id="FABODIR" Action="ResetFABODIR" Value="{}" After="SetFABODIR" Sequence="execute" Condition="NOT (FABODIR ~= FABODIR_HOME)" />

    <!-- %LOCALAPPDATA%\Fabo: fabo-win.exe keeps setup.json, its log and downloads here too. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(Name)">
        <Directory Id="BinFolder" Name="bin">
          <Directory Id="PluginsFolder" Name="cli-plugins" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!--
      Per-user components key on HKCU values, not files (ICE38). The bundle
      files keep their names and places: fabo-win verifies each of them
      against the SHA-256 embedded at build time before it imports or copies
      anything.
    -->
    <ComponentGroup Id="FaboComponents">
      <Component Id="FaboApp" Directory="INSTALLFOLDER" Guid="17FB18D7-6CEA-446F-98A2-450A7E15639C">
        <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)" Name="Version" Type="string" Value="$(Version)" />
        <File Id="FaboWinExe" Source="$(Bundle)\fabo-win.exe" />
        <!-- The window and tray; the terminal's libghostty-vt loads from beside it. -->
        <File Id="FaboDesktopExe" Source="$(Bundle)\fabo-desktop.exe" />
        <File Id="GhosttyVtDll" Source="$(Bundle)\ghostty-vt.dll" />
        <!-- The Linux engine, for a distro of the user's own and for updates (install.sh). -->
        <File Id="FaboEngine" Source="$(Bundle)\fabo" />
        <File Id="FaboDaemon" Source="$(Bundle)\fabo-daemon" />
        <File Id="FaboInit" Source="$(Bundle)\fabo-init" />
        <File Id="FaboStart" Source="$(Bundle)\fabo-start" />
        <File Id="FaboLinux" Source="$(Bundle)\fabo-linux.tar.gz" />
        <File Id="InstallSh" Source="$(Bundle)\install.sh" />
        <File Id="FaboPs1" Source="$(Bundle)\fabo.ps1" />
        <File Id="FaboLicense" Source="$(Bundle)\LICENSE" />
        <File Id="FaboNotice" Source="$(Bundle)\NOTICE" />
        <!-- Run by fabo-win as files (-File), never as script text it carries: setup's tools step, and its elevated steps (WSL, the DNS rule). -->
        <File Id="SetupToolsPs1" Source="$(Bundle)\setup-tools.ps1" />
        <File Id="FaboAdminPs1" Source="$(Bundle)\fabo-admin.ps1" />
        <Shortcut Id="StartMenuShortcut"
                  Directory="ProgramMenuFolder"
                  Name="$(Name)"
                  Description="$(Description)"
                  Target="[#FaboWinExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FaboIcon" />
        <util:RemoveFolderEx On="uninstall" Property="FABODIR" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>
      <Component Id="FaboDockerCli" Directory="BinFolder" Guid="DD3D4B27-87B9-4ED0-B7DA-314B02B1DD3D">
        <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)" Name="Bin" Type="string" Value="[BinFolder]" KeyPath="yes" />
        <File Id="DockerExe" Source="$(Bundle)\bin\docker.exe" />
        <!-- `fabo` in PowerShell, cmd and Git Bash (engine/cmd/fabo/main_windows.go). -->
        <File Id="FaboCliExe" Source="$(Bundle)\bin\fabo.exe" />
        <RemoveFolder Id="RemoveBinFolder" Directory="BinFolder" On="uninstall" />
      </Component>
      <Component Id="FaboDockerPlugins" Directory="PluginsFolder" Guid="E7E1941A-FEBF-4879-89EF-BA0D486E5AD1">
        <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)" Name="Plugins" Type="string" Value="[PluginsFolder]" KeyPath="yes" />
        <File Id="ComposeExe" Source="$(Bundle)\bin\cli-plugins\docker-compose.exe" />
        <File Id="BuildxExe" Source="$(Bundle)\bin\cli-plugins\docker-buildx.exe" />
        <RemoveFolder Id="RemovePluginsFolder" Directory="PluginsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="$(Name)" Level="1">
      <ComponentGroupRef Id="FaboComponents" />
    </Feature>

    <!-- A running Fabo, the host and the window, is closed before its files are replaced or removed. -->
    <util:CloseApplication Id="CloseFaboWin" Target="fabo-win.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseFaboDesktop" Target="fabo-desktop.exe" CloseMessage="yes" TerminateProcess="1" RebootPrompt="no" />

    <!--
      Uninstall: undo what first-run setup did (engine in WSL, PATH, docker
      context and builder, start at sign-in). fabo.ps1 does nothing when
      setup never completed, so removing an unused install is just files.
      System64Folder is the 64-bit PowerShell: for the 32-bit msiexec,
      SystemFolder is SysWOW64, and a 32-bit PowerShell from there sees
      SysWOW64 in place of System32, where wsl.exe is not. The script logs
      to %TEMP%\fabo-uninstall.log (INSTALLFOLDER is going).
    -->
    <CustomAction Id="FaboUninstall"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]fabo.ps1&quot; -Uninstall -IfSetUp"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="FaboUninstall" After="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!--
      The pages, as drawn in the Fabo Installer Windows design: Welcome,
      licence, ready, progress, done. All but the ready page are stock
      WixUI dialogs. It is WixUI_InstallDir without its folder page:
      fabo-win runs from %LOCALAPPDATA%\Fabo and nowhere else, so the
      folder is not a choice; the ready page (FaboReadyDlg, below) shows
      it instead, with the size and the scope. Repair and remove still go
      through the stock VerifyReadyDlg.
      The art is committed in brand\installer\windows: wix-dialog.bmp (night
      panel at the left, white under the text) and wix-banner.bmp (chalk,
      the lockup at the right). scripts/windows-msi.ps1 stamps the version onto a
      copy of the dialog (make-bitmaps.ps1 -Stamp, no browser needed, so CI
      builds from the checkout) and points Assets at it. The texts are in
      fabo.wxl.
    -->
    <?ifndef Assets ?><?define Assets = "..\..\brand\installer\windows" ?><?endif?>
    <WixVariable Id="WixUIBannerBmp" Value="$(Assets)\wix-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(Assets)\wix-dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <UI Id="WixUI_Fabo">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <!-- The ready page's table: labels in the design's slate, values in the system monospace. -->
      <TextStyle Id="Fabo_Font_Label" FaceName="Segoe UI" Size="9" Red="58" Green="66" Blue="76" />
      <TextStyle Id="Fabo_Font_Mono" FaceName="Consolas" Size="9" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="ARPNOMODIFY" Value="1" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="FaboReadyDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="FaboReadyDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="1" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- The last page offers to launch Fabo, which runs first-run setup. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFabo"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <!--
        The ready page of a fresh install, as the design draws it: the stock
        VerifyReadyDlg's words, then the folder, the size and the scope in a
        table, since there was no folder page to say them. Its measurements
        are VerifyReadyDlg's (370 by 270 dialog units, the banner 44 high).
      -->
      <Dialog Id="FaboReadyDlg" Width="370" Height="270" Title="!(loc.VerifyReadyDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.FaboReadyTitle)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="60" Width="320" Height="30" Transparent="yes" NoPrefix="yes" Text="!(loc.VerifyReadyDlgInstallText)" />
        <Control Id="FolderLabel" Type="Text" X="25" Y="104" Width="40" Height="12" Transparent="yes" NoPrefix="yes" Text="!(loc.FaboReadyFolder)" />
        <Control Id="FolderValue" Type="Text" X="70" Y="104" Width="280" Height="12" Transparent="yes" NoPrefix="yes" Text="{\Fabo_Font_Mono}[INSTALLFOLDER]" />
        <Control Id="SizeLabel" Type="Text" X="25" Y="122" Width="40" Height="12" Transparent="yes" NoPrefix="yes" Text="!(loc.FaboReadySize)" />
        <Control Id="SizeValue" Type="Text" X="70" Y="122" Width="280" Height="12" Transparent="yes" NoPrefix="yes" Text="{\Fabo_Font_Mono}$(Size)" />
        <Control Id="ScopeLabel" Type="Text" X="25" Y="140" Width="40" Height="12" Transparent="yes" NoPrefix="yes" Text="!(loc.FaboReadyScope)" />
        <Control Id="ScopeValue" Type="Text" X="70" Y="140" Width="280" Height="12" Transparent="yes" NoPrefix="yes" Text="!(loc.FaboReadyScopeValue)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.VerifyReadyDlgInstall)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.FaboExitCheckbox)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.FaboExitText)" />
    <Property Id="WixShellExecTarget" Value="[#FaboWinExe]" />
    <CustomAction Id="LaunchFabo" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Impersonate="yes" Return="ignore" />
  </Package>
</Wix>

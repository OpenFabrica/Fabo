# Fabo on a Linux host, as the .deb and .rpm install it: containers on this
# machine's kernel, no VM. Users in the `fabo` group reach the API at
# unix:///run/fabo/docker.sock:
#   docker context create fabo --docker host=unix:///run/fabo/docker.sock
# and, while no Docker engine has it, at /var/run/docker.sock too.
[Unit]
Description=Fabo container engine
Documentation=https://runkiri.com
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/fabo daemon
Environment=FABO_SOCKET=/run/fabo/docker.sock
Environment=FABO_SOCKET_GROUP=fabo
Environment=HOME=/var/lib/fabo-daemon
# The daemon creates the cgroups its containers run in.
Delegate=yes
KillMode=mixed
Restart=on-failure
# Tools that ignore docker contexts (docker-py, Go's client.FromEnv,
# docker-java, Testcontainers, IDE plugins) look for /var/run/docker.sock
# (/run/docker.sock): when nothing is there, it links to Fabo's socket, whose
# 0660 root:fabo is what counts. Docker's docker.socket or dockerd replaces
# a link when it starts, so Docker keeps the path whenever it runs, and the
# link goes when Fabo stops, if it is still Fabo's.
ExecStartPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" = /run/fabo/docker.sock ] || [ -e /run/docker.sock ] || [ -L /run/docker.sock ] || ln -s /run/fabo/docker.sock /run/docker.sock'
ExecStopPost=-/bin/sh -c '[ "$$(readlink /run/docker.sock)" != /run/fabo/docker.sock ] || rm -f /run/docker.sock'
RuntimeDirectory=fabo
# 0755: members of fabo reach the socket (itself 0660 root:fabo) through it.
RuntimeDirectoryMode=0755
StateDirectory=fabo-daemon
StateDirectoryMode=0700
# What the daemon writes is for root and the fabo group only (/var/lib/fabo
# itself is 0710: fabo-init sets that, and its own umask, when it starts).
UMask=0027

[Install]
WantedBy=multi-user.target

#!/bin/sh
# fabo / fabo-lite .deb: before the files go. Stops the engine (containers it
# ran stop with it) and withdraws Fabo's docker CLI from PATH.
set -e
# Removing Fabo stops everything it runs: the engine (above, which stops its
# containers), and any window or fabo command still open from this package
# (`fabo share`, `fabo ui`), first asked to quit, then made to.
stop_everything() {
  for sig in TERM KILL; do
    pkill -"$sig" -f '^/usr/lib/fabo/fabo-window( |$)' 2>/dev/null || true
    pkill -"$sig" -f '^(/usr)?/bin/fabo( |$)' 2>/dev/null || true
    [ "$sig" = KILL ] || sleep 1
  done
}
case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now fabo.service || true
    fi
    stop_everything
    if [ -x /usr/libexec/fabo/docker ]; then
      update-alternatives --remove docker /usr/libexec/fabo/docker || true
      for p in docker-compose docker-buildx; do
        update-alternatives --remove "$p" "/usr/libexec/fabo/cli-plugins/$p" || true
      done
    fi
    ;;
esac
exit 0
